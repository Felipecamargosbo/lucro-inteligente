// Configuração da Cloudflare Workers para o NEXO.
// O "name" precisa ser exatamente igual ao nome do Worker criado no painel da Cloudflare.
// O resto (arquivo do servidor e pasta do site) é gerado sozinho no build.
{
  "name": "nexo",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  }
}
